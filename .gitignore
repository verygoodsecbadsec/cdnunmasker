# ===========================================================
# CDN-Unmasker .gitignore
# ===========================================================

# --- Recon output directories ------------------------------
# Every run creates a timestamped folder: recon_<domain>_<timestamp>/
# Never commit scan results — they may contain client data.
recon_*/

# --- Pcap files --------------------------------------------
*.pcap
*.pcapng
*.cap

# --- Wordlists ---------------------------------------------
# These are large files sourced from SecLists — don't commit them.
subdomains-top1million-110000.txt
subdomains-top1million-5000000.txt
*.txt.bak

# --- CloudRip ----------------------------------------------
# Cloned as a dependency — not part of this repo.
CloudRip/

# --- CDN range cache ---------------------------------------
# Generated fresh on each run.
cdn_ranges.txt

# --- API keys and secrets ----------------------------------
.env
.env.*
*.key
secrets.txt
config.local.*

# --- Nmap output -------------------------------------------
*.nmap
*.gnmap
*.xml

# --- OS junk -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editor and IDE files ----------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- Python artifacts --------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# --- Shell history and temp files --------------------------
.bash_history
.zsh_history
*.tmp
*.temp
*.bak
*.orig

# --- Log files ---------------------------------------------
*.log
logs/

# --- Test and scratch output -------------------------------
test_*/
scratch/
sandbox/
